# Copiar a .env y ajustar. Nunca commitear secretos reales.
NODE_ENV=development
API_PORT=3000

# Rol owner: migraciones. Rol app: runtime sin BYPASSRLS.
DATABASE_URL=postgresql://zulu:zulu_dev@localhost:5433/zulu_admin?schema=public
APP_DATABASE_URL=postgresql://zulu_app:zulu_app_dev@localhost:5433/zulu_admin?schema=public

JWT_ACCESS_SECRET=cambiar-por-cadena-aleatoria-de-al-menos-32-caracteres
JWT_ACCESS_TTL_SEG=900
# Renovación: vence tras 12 h sin uso; máximo 7 días por familia de sesión
REFRESH_INACTIVIDAD_HORAS=12
REFRESH_MAX_DIAS=7
# Clave AES-256 (32 bytes en base64) para cifrar secretos TOTP. Generar: openssl rand -base64 32
MFA_ENC_KEY=cambiar-por-32-bytes-en-base64
# Origen permitido de la web (CORS y verificación de Origin en /auth/refresh)
WEB_ORIGIN=http://localhost:5173
# Límite de peticiones por minuto e IP en endpoints de autenticación
AUTH_RATE_LIMIT=10

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=zulu-documentos
S3_ACCESS_KEY=zulu
S3_SECRET_KEY=zulu_dev_secret

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="ZULU ADMIN <no-responder@zulu.test>"

# Solo seed de desarrollo (datos ficticios)
SEED_PASSWORD=Majagua-dev-2026!
