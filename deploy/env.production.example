# Variables que lee docker-compose.production.yml mediante interpolación.
# Genere las claves en el servidor y guarde el archivo real como .env.
ZULU_DB_OWNER_PASSWORD=GENERAR_HEX_ALEATORIO
ZULU_APP_DB_PASSWORD=GENERAR_HEX_ALEATORIO
ZULU_JWT_ACCESS_SECRET=GENERAR_CADENA_ALEATORIA_DE_32_O_MAS_CARACTERES
ZULU_MFA_ENC_KEY=GENERAR_BASE64_DE_32_BYTES

# SMTP para invitaciones y recuperación de contraseña (Gmail con clave de aplicación).
# La clave de aplicación se crea en https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos en la cuenta Google).
ZULU_SMTP_HOST=smtp.gmail.com
ZULU_SMTP_PORT=587
ZULU_SMTP_USER=CUENTA_GMAIL_REMITENTE
ZULU_SMTP_PASS=CLAVE_DE_APLICACION_16_CARACTERES
# 465 = TLS directo (true); 587 = STARTTLS (false o vacío)
ZULU_SMTP_SECURE=false
# Gmail solo envía como la cuenta autenticada: use esa misma dirección.
ZULU_MAIL_FROM=ZULU ADMIN <CUENTA_GMAIL_REMITENTE>
