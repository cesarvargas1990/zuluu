  tipo              String    @db.VarChar(60)
  entidad           String?   @db.VarChar(160)
  radicado          String?   @db.VarChar(120)
  descripcion       String    @db.VarChar(4000)
  fechaExpedicion   DateTime? @map("fecha_expedicion") @db.Date
  fechaRecepcion    DateTime? @map("fecha_recepcion") @db.Date
  fechaNotificacion DateTime? @map("fecha_notificacion") @db.Date
  estado            String    @default("PENDIENTE_VERIFICACION") @db.VarChar(40)
  responsable       String?   @db.VarChar(180)
  creadoPor         String    @map("creado_por") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

