// ZULU ADMIN — modelo base (fundación multi-tenant).
// Los módulos M01–M10 se agregan vía cambios SDD (openspec/changes).
// Regla: toda tabla con datos de un condominio lleva condominio_id + política RLS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMINISTRADORA
  ASISTENTE
  CONTADORA
  ASESOR_JURIDICO
  OPERACIONES
  CONSEJO
}

enum TipoPersonaPropietaria {
  NATURAL
  JURIDICA
}

enum TipoUnidadPrivada {
  VILLA
  LOTE
}

enum TipoTitularidad {
  TITULAR
  COTITULAR
}

enum EstadoTitularidad {
  PENDIENTE_VALIDAR
  VALIDADO
  OBSERVADO
}

enum EstadoImportacionPropietarios {
  PENDIENTE_REVISION
  APROBADA
  RECHAZADA
}

enum EstadoProcesoAmbiental {
  POR_VERIFICAR
  SOLICITADO
  RADICADO
  REQUERIDO
  PRORROGADO
  EN_TRAMITE
  APROBADO
  NEGADO
  DESISTIDO
  CERRADO
}

enum EstadoObligacionAmbiental {
  PENDIENTE_VALIDAR
  ABIERTA
  EN_CURSO
  CUMPLIDA
  VENCIDA
  CANCELADA
}

enum EstadoPeriodoCobro {
  CONFIGURADO
  BORRADORES_GENERADOS
  CERRADO
}

enum EstadoCuentaCobro {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADO
  EMITIDO
  ANULADO
}

enum EstadoEnvioCuentaCobro {
  PENDIENTE
  ENVIADO
  FALLIDO
}

/// Copropiedad: unidad de aislamiento (RLS). En pantalla se llama "copropiedad"; el "condominio" es su agrupador.
model Condominio {
  id          String   @id @default(uuid()) @db.Uuid
  razonSocial String   @map("razon_social")
  nit         String   @unique
  grupoId     String?  @map("grupo_id") @db.Uuid
  config      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  membresias            Membresia[]
  auditoria             Auditoria[]
  permisos              Permiso[]
  accesosExcepcionales  AccesoExcepcional[]
  propietarios          Propietario[]
  unidades              UnidadPrivada[]
  titularidades         Titularidad[]
  importaciones         ImportacionPropietarios[]
  recaudos              Recaudo[]
  importacionesRecaudos ImportacionRecaudos[]
  obligaciones          Obligacion[]
  periodosCobro         PeriodoCobro[]
  conceptosCobro        ConceptoCobro[]
  cuentasCobro          CuentaCobro[]
  enviosCuentaCobro     EnvioCuentaCobro[]
  procesosAmbientales   ProcesoAmbiental[]
  expedientesDigitales  ExpedienteDigital[]
  documentosDigitales   DocumentoDigital[]
  grupo                 GrupoCondominio?          @relation(fields: [grupoId], references: [id])

  @@index([grupoId])
  @@map("condominio")
}

/// Condominio (agrupador de copropiedades). Global: no pertenece a una copropiedad, sin RLS.
model GrupoCondominio {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String   @unique @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  copropiedades Condominio[]

  @@map("condominio_grupo")
}

model Usuario {
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique
  nombre            String
  passwordHash      String?            @map("password_hash")
  esSuperadmin      Boolean            @default(false) @map("es_superadmin")
  activo            Boolean            @default(true)
  intentosFallidos  Int                @default(0) @map("intentos_fallidos")
  bloqueadoHasta    DateTime?          @map("bloqueado_hasta") @db.Timestamptz(3)
  /// TOTP cifrado AES-256-GCM (iv.tag.datos en base64). Nunca en claro.
  mfaSecretoCifrado String?            @map("mfa_secreto_cifrado")
  mfaActivadoEn     DateTime?          @map("mfa_activado_en") @db.Timestamptz(3)
  mfaPolitica       PoliticaMfaUsuario @default(HEREDAR) @map("mfa_politica")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  membresias           Membresia[]
  sesiones             Sesion[]
  codigosRespaldo      CodigoRespaldo[]
  tokensRecuperacion   TokenRecuperacion[]
  accesosExcepcionales AccesoExcepcional[]
  expedientesResponsable ExpedienteDigital[]

  @@map("usuario")
}

/// Vincula un usuario a un condominio con un rol. Permisos finos (área/acción/expediente) llegan con el módulo de autorización.
model Membresia {
  id           String   @id @default(uuid()) @db.Uuid
  condominioId String   @map("condominio_id") @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  rol          Rol
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  condominio Condominio @relation(fields: [condominioId], references: [id])
  usuario    Usuario    @relation(fields: [usuarioId], references: [id])
  permisos   Permiso[]

  @@unique([condominioId, usuarioId, rol])
  @@index([condominioId])
  @@map("membresia")
}

/// Bitácora append-only: el rol de aplicación no puede UPDATE/DELETE (ver migración).
model Auditoria {
  id           BigInt   @id @default(autoincrement())
  condominioId String?  @map("condominio_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  accion       String
  objetoTipo   String   @map("objeto_tipo")
  objetoId     String?  @map("objeto_id")
  antes        Json?
  despues      Json?
  ip           String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  condominio Condominio? @relation(fields: [condominioId], references: [id])

  @@index([condominioId, createdAt])
  @@map("auditoria")
}

/// Ajuste individual de la verificación en dos pasos. Solo aplica si el control global está encendido.
enum PoliticaMfaUsuario {
  /// Sin ajuste: rige la regla por rol de siempre.
  HEREDAR
  OBLIGATORIO
  NO_REQUERIDO
}

enum Accion {
  leer
  crear
  editar
  aprobar
  exportar
  eliminar
}

enum EfectoPermiso {
  CONCEDER
  RESTRINGIR
}

model CodigoRespaldo {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  hash      String
  usadoEn   DateTime? @map("usado_en") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("codigo_respaldo")
}

/// Sesión de renovación (refresh opaco, solo se guarda su SHA-256). Global, solo módulo auth.
model Sesion {
  id             String    @id @default(uuid()) @db.Uuid
  usuarioId      String    @map("usuario_id") @db.Uuid
  familiaId      String    @map("familia_id") @db.Uuid
  refreshHash    String    @unique @map("refresh_hash")
  mfaVerificado  Boolean   @default(false) @map("mfa_verificado")
  expiraEn       DateTime  @map("expira_en") @db.Timestamptz(3)
  revocadaEn     DateTime? @map("revocada_en") @db.Timestamptz(3)
  reemplazadaPor String?   @map("reemplazada_por") @db.Uuid
  ip             String?
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([familiaId])
  @@map("sesion")
}

model TokenRecuperacion {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  hash      String    @unique
  expiraEn  DateTime  @map("expira_en") @db.Timestamptz(3)
  usadoEn   DateTime? @map("usado_en") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("token_recuperacion")
}

/// Concesión o restricción explícita sobre la matriz por defecto del rol.
model Permiso {
  id           String        @id @default(uuid()) @db.Uuid
  condominioId String        @map("condominio_id") @db.Uuid
  membresiaId  String        @map("membresia_id") @db.Uuid
  area         String        @db.VarChar(2)
  accion       Accion
  expedienteId String?       @map("expediente_id") @db.Uuid
  efecto       EfectoPermiso
  creadoPor    String        @map("creado_por") @db.Uuid
  revocadoEn   DateTime?     @map("revocado_en") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  condominio Condominio @relation(fields: [condominioId], references: [id])
  membresia  Membresia  @relation(fields: [membresiaId], references: [id])

  @@index([condominioId, membresiaId])
  @@map("permiso")
}

/// Acceso temporal y justificado de un superadministrador a datos de un condominio.
model AccesoExcepcional {
  id            String    @id @default(uuid()) @db.Uuid
  condominioId  String    @map("condominio_id") @db.Uuid
  usuarioId     String    @map("usuario_id") @db.Uuid
  justificacion String
  venceEn       DateTime  @map("vence_en") @db.Timestamptz(3)
  revocadoEn    DateTime? @map("revocado_en") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  condominio Condominio @relation(fields: [condominioId], references: [id])
  usuario    Usuario    @relation(fields: [usuarioId], references: [id])

  @@index([condominioId, usuarioId])
  @@map("acceso_excepcional")
}

/// Persona o entidad propietaria. Los datos de contacto pueden quedar pendientes.
model Propietario {
  id              String                 @id @default(uuid()) @db.Uuid
  condominioId    String                 @map("condominio_id") @db.Uuid
  tipoPersona     TipoPersonaPropietaria @default(NATURAL) @map("tipo_persona")
  nombre          String                 @db.VarChar(180)
  tipoDocumento   String?                @map("tipo_documento") @db.VarChar(40)
  numeroDocumento String?                @map("numero_documento") @db.VarChar(80)
  telefono        String?                @db.VarChar(40)
  correo          String?                @db.VarChar(254)
  direccion       String?                @db.VarChar(300)
  activo          Boolean                @default(true)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  condominio    Condominio             @relation(fields: [condominioId], references: [id])
  titularidades Titularidad[]
  documentos    DocumentoPropietario[]
  expedientesDigitales ExpedienteDigital[]
  recaudos      Recaudo[]

  @@unique([condominioId, id])
  @@index([condominioId, activo, nombre])
  @@index([condominioId, tipoDocumento, numeroDocumento])
  @@map("propietario")
}

model DocumentoPropietario {
  id            String   @id @default(uuid()) @db.Uuid
  condominioId  String   @map("condominio_id") @db.Uuid
  propietarioId String   @map("propietario_id") @db.Uuid
  nombre        String   @db.VarChar(180)
  mimeType      String   @map("mime_type") @db.VarChar(100)
  tamano        Int
  contenido     Bytes    @db.ByteA
  creadoPor     String   @map("creado_por") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  propietario Propietario @relation(fields: [condominioId, propietarioId], references: [condominioId, id])

  @@index([condominioId, propietarioId, createdAt])
  @@map("documento_propietario")
}

model ImportacionPropietarios {
  id           String                        @id @default(uuid()) @db.Uuid
  condominioId String                        @map("condominio_id") @db.Uuid
  archivo      String                        @db.VarChar(180)
  filas        Json
  resumen      Json
  estado       EstadoImportacionPropietarios @default(PENDIENTE_REVISION)
  creadaPor    String                        @map("creada_por") @db.Uuid
  aprobadaPor  String?                       @map("aprobada_por") @db.Uuid
  creadaEn     DateTime                      @default(now()) @map("creada_en") @db.Timestamptz(3)
  revisadaEn   DateTime?                     @map("revisada_en") @db.Timestamptz(3)

  condominio Condominio @relation(fields: [condominioId], references: [id])

  @@index([condominioId, estado, creadaEn])
  @@map("importacion_propietarios")
}

/// Unidad privada de la copropiedad; el código es único dentro del condominio.
model UnidadPrivada {
  id                    String            @id @default(uuid()) @db.Uuid
  condominioId          String            @map("condominio_id") @db.Uuid
  codigo                String            @db.VarChar(60)
  tipo                  TipoUnidadPrivada
  areaM2                Decimal?          @map("area_m2") @db.Decimal(12, 2)
  coeficiente           Decimal?          @db.Decimal(9, 6)
  cuotaMensual          Decimal?          @map("cuota_mensual") @db.Decimal(14, 2)
  matriculaInmobiliaria String?           @map("matricula_inmobiliaria") @db.VarChar(80)
  estadoJuridico        String?           @map("estado_juridico") @db.VarChar(120)
  activa                Boolean           @default(true)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  condominio    Condominio       @relation(fields: [condominioId], references: [id])
  titularidades Titularidad[]
  recaudos      Recaudo[]
  obligaciones  Obligacion[]
  cuentasCobro  CuentaCobro[]
  gestiones     GestionCobro[]
  compromisos   CompromisoPago[]
  expedientesDigitales ExpedienteDigital[]

  @@unique([condominioId, codigo])
  @@unique([condominioId, id])
  @@index([condominioId, tipo, activa])
  @@map("unidad_privada")
}

/// Relación temporal e históricamente conservada entre una persona y una unidad.
model Titularidad {
  id            String            @id @default(uuid()) @db.Uuid
  condominioId  String            @map("condominio_id") @db.Uuid
  propietarioId String            @map("propietario_id") @db.Uuid
  unidadId      String            @map("unidad_id") @db.Uuid
  tipo          TipoTitularidad
  estado        EstadoTitularidad @default(PENDIENTE_VALIDAR)
  desde         DateTime?         @db.Date
  hasta         DateTime?         @db.Date
  fuente        String?           @db.VarChar(240)
  soporte       String?           @db.VarChar(500)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  condominio  Condominio    @relation(fields: [condominioId], references: [id])
  propietario Propietario   @relation(fields: [condominioId, propietarioId], references: [condominioId, id])
  unidad      UnidadPrivada @relation(fields: [condominioId, unidadId], references: [condominioId, id])

  @@index([condominioId, unidadId, hasta])
  @@index([condominioId, propietarioId, hasta])
  @@map("titularidad")
}

enum MedioPago {
  TRANSFERENCIA
  CONSIGNACION
  EFECTIVO
  OTRO
}

enum EstadoRecaudo {
  PENDIENTE
  VERIFICADO
  OBSERVADO
  ANULADO
}

enum ConceptoImputacion {
  CUOTA_ADMINISTRACION
  CUOTA_VENCIDA
  INTERESES
  CUOTA_EXTRAORDINARIA
  OTRO
  SALDO_INICIAL
}

enum OrigenRecaudo {
  MANUAL
  IMPORTACION
}

enum EstadoImportacionRecaudos {
  PENDIENTE
  CONFIRMADA
  DESCARTADA
}

/// Pago recibido (REQ-003). Nunca se borra: se anula con motivo. Sin unidad queda por identificar.
model Recaudo {
  id                      String        @id @default(uuid()) @db.Uuid
  condominioId            String        @map("condominio_id") @db.Uuid
  /// Consecutivo por condominio; se muestra como RC-0001.
  numero                  Int
  unidadId                String?       @map("unidad_id") @db.Uuid
  propietarioId           String?       @map("propietario_id") @db.Uuid
  pagador                 String?       @db.VarChar(180)
  fechaPago               DateTime      @map("fecha_pago") @db.Date
  valor                   Decimal       @db.Decimal(18, 2)
  medio                   MedioPago
  referencia              String?       @db.VarChar(80)
  banco                   String?       @db.VarChar(120)
  observacion             String?       @db.VarChar(1000)
  estado                  EstadoRecaudo @default(PENDIENTE)
  origen                  OrigenRecaudo @default(MANUAL)
  importacionId           String?       @map("importacion_id") @db.Uuid
  posibleDuplicado        Boolean       @default(false) @map("posible_duplicado")
  /// Excedente no imputado al verificar (anticipo).
  saldoAFavor             Decimal       @default(0) @map("saldo_a_favor") @db.Decimal(18, 2)
  observacionVerificacion String?       @map("observacion_verificacion") @db.VarChar(1000)
  revisadoPor             String?       @map("revisado_por") @db.Uuid
  revisadoEn              DateTime?     @map("revisado_en") @db.Timestamptz(3)
  anuladoPor              String?       @map("anulado_por") @db.Uuid
  anuladoEn               DateTime?     @map("anulado_en") @db.Timestamptz(3)
  motivoAnulacion         String?       @map("motivo_anulacion") @db.VarChar(1000)
  creadoPor               String        @map("creado_por") @db.Uuid
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  condominio   Condominio          @relation(fields: [condominioId], references: [id])
  unidad       UnidadPrivada?      @relation(fields: [condominioId, unidadId], references: [condominioId, id])
  propietario  Propietario?        @relation(fields: [condominioId, propietarioId], references: [condominioId, id])
  imputaciones ImputacionRecaudo[]
  soportes     SoporteRecaudo[]

  @@unique([condominioId, numero])
  @@unique([condominioId, id])
  @@index([condominioId, estado, fechaPago])
  @@index([condominioId, unidadId])
  @@index([condominioId, referencia])
  @@map("recaudo")
}

/// Distribución de un pago verificado. Inmutable: se crea una sola vez al verificar.
model ImputacionRecaudo {
  id              String             @id @default(uuid()) @db.Uuid
  condominioId    String             @map("condominio_id") @db.Uuid
  recaudoId       String             @map("recaudo_id") @db.Uuid
  concepto        ConceptoImputacion
  /// Periodo AAAA-MM.
  periodo         String             @db.VarChar(7)
  valorObligacion Decimal?           @map("valor_obligacion") @db.Decimal(18, 2)
  valorAplicado   Decimal            @map("valor_aplicado") @db.Decimal(18, 2)
  /// Obligación de cartera que este valor paga (REQ-004); null si no había obligación registrada.
  obligacionId    String?            @map("obligacion_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  recaudo Recaudo @relation(fields: [condominioId, recaudoId], references: [condominioId, id])

  @@index([condominioId, recaudoId])
  @@map("imputacion_recaudo")
}

/// Comprobante de un pago. Original inmutable con SHA-256.
model SoporteRecaudo {
  id           String   @id @default(uuid()) @db.Uuid
  condominioId String   @map("condominio_id") @db.Uuid
  recaudoId    String   @map("recaudo_id") @db.Uuid
  nombre       String   @db.VarChar(180)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  tamano       Int
  sha256       String   @db.Char(64)
  contenido    Bytes    @db.ByteA
  creadoPor    String   @map("creado_por") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  recaudo Recaudo @relation(fields: [condominioId, recaudoId], references: [condominioId, id])

  @@index([condominioId, recaudoId, createdAt])
  @@map("soporte_recaudo")
}

/// Borrador de importación de pagos: filas ya revisadas; nada se crea hasta confirmar.
model ImportacionRecaudos {
  id            String                    @id @default(uuid()) @db.Uuid
  condominioId  String                    @map("condominio_id") @db.Uuid
  archivo       String                    @db.VarChar(180)
  filas         Json
  resumen       Json
  estado        EstadoImportacionRecaudos @default(PENDIENTE)
  creadaPor     String                    @map("creada_por") @db.Uuid
  confirmadaPor String?                   @map("confirmada_por") @db.Uuid
  creadaEn      DateTime                  @default(now()) @map("creada_en") @db.Timestamptz(3)
  cerradaEn     DateTime?                 @map("cerrada_en") @db.Timestamptz(3)

  condominio Condominio @relation(fields: [condominioId], references: [id])

  @@index([condominioId, estado, creadaEn])
  @@map("importacion_recaudos")
}

enum OrigenObligacion {
  MANUAL
  GENERACION
  IMPORTACION
}

enum TipoMovimientoCartera {
  CARGO
  PAGO
  REVERSO_PAGO
  AJUSTE_DEBITO
  AJUSTE_CREDITO
  CREDITO_APLICADO
}

enum TipoAjusteCartera {
  DEBITO
  CREDITO
}

enum EstadoAjusteCartera {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum CanalGestion {
  TELEFONO
  CORREO
  WHATSAPP
  PRESENCIAL
  CARTA
  OTRO
}

enum EstadoCompromiso {
  ABIERTO
  CUMPLIDO
  INCUMPLIDO
  CANCELADO
}

enum EstadoImportacionCartera {
  PENDIENTE
  APROBADA
  DESCARTADA
}

/// Obligación de una unidad (REQ-004). Inmutable: su saldo resulta de los movimientos de cartera.
model Obligacion {
  id               String             @id @default(uuid()) @db.Uuid
  condominioId     String             @map("condominio_id") @db.Uuid
  /// Consecutivo por condominio; se muestra como OBL-00001.
  numero           Int
  unidadId         String             @map("unidad_id") @db.Uuid
  concepto         ConceptoImputacion
  /// Periodo AAAA-MM.
  periodo          String             @db.VarChar(7)
  descripcion      String?            @db.VarChar(300)
  fechaEmision     DateTime           @map("fecha_emision") @db.Date
  fechaVencimiento DateTime           @map("fecha_vencimiento") @db.Date
  valor            Decimal            @db.Decimal(18, 2)
  origen           OrigenObligacion   @default(MANUAL)
  importacionId    String?            @map("importacion_id") @db.Uuid
  creadoPor        String             @map("creado_por") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  condominio  Condominio          @relation(fields: [condominioId], references: [id])
  unidad      UnidadPrivada       @relation(fields: [condominioId, unidadId], references: [condominioId, id])
  movimientos MovimientoCartera[]
  ajustes     AjusteCartera[]

  @@unique([condominioId, numero])
  @@unique([condominioId, id])
  @@index([condominioId, unidadId, periodo])
  @@index([condominioId, fechaVencimiento])
  @@map("obligacion")
