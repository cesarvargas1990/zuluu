  documento DocumentoAmbiental @relation(fields: [condominioId, documentoId], references: [condominioId, id])
  proceso   ProcesoAmbiental   @relation(fields: [condominioId, procesoId], references: [condominioId, id])

  @@unique([condominioId, documentoId, procesoId])
  @@index([condominioId, procesoId])
  @@map("relacion_documento_ambiental")
}

model RelacionProcesoAmbiental {
  id           String   @id @default(uuid()) @db.Uuid
  condominioId String   @map("condominio_id") @db.Uuid
  origenId     String   @map("origen_id") @db.Uuid
  destinoId    String   @map("destino_id") @db.Uuid
  motivo       String   @db.VarChar(500)
  creadoPor    String   @map("creado_por") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  origen  ProcesoAmbiental @relation("ProcesoOrigen", fields: [condominioId, origenId], references: [condominioId, id])
  destino ProcesoAmbiental @relation("ProcesoDestino", fields: [condominioId, destinoId], references: [condominioId, id])

  @@unique([condominioId, origenId, destinoId])
  @@index([condominioId, destinoId])
  @@map("relacion_proceso_ambiental")
}

model MovimientoFinancieroAmbiental {
  id           String    @id @default(uuid()) @db.Uuid
  condominioId String    @map("condominio_id") @db.Uuid
  procesoId    String    @map("proceso_id") @db.Uuid
  tipo         String    @db.VarChar(30)
  concepto     String    @db.VarChar(240)
  valor        Decimal   @db.Decimal(18, 2)
  fecha        DateTime? @db.Date
  referencia   String?   @db.VarChar(120)
  estado       String    @default("PENDIENTE_CONCILIACION") @db.VarChar(40)
  nota         String?   @db.VarChar(1000)
  creadoPor    String    @map("creado_por") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  proceso ProcesoAmbiental @relation(fields: [condominioId, procesoId], references: [condominioId, id])

  @@index([condominioId, procesoId, createdAt])
  @@map("movimiento_financiero_ambiental")
}

/// Libro de cartera, solo se agrega: cargos, pagos verificados, reversos, ajustes y créditos aplicados.
model MovimientoCartera {
  id           String                @id @default(uuid()) @db.Uuid
  condominioId String                @map("condominio_id") @db.Uuid
  unidadId     String                @map("unidad_id") @db.Uuid
  obligacionId String                @map("obligacion_id") @db.Uuid
  tipo         TipoMovimientoCartera
  /// Siempre positivo; el signo lo define el tipo.
  valor        Decimal               @db.Decimal(18, 2)
  fecha        DateTime              @db.Date
  recaudoId    String?               @map("recaudo_id") @db.Uuid
  imputacionId String?               @map("imputacion_id") @db.Uuid
  ajusteId     String?               @map("ajuste_id") @db.Uuid
  descripcion  String?               @db.VarChar(300)
  creadoPor    String                @map("creado_por") @db.Uuid
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  obligacion Obligacion @relation(fields: [condominioId, obligacionId], references: [condominioId, id])

  @@index([condominioId, obligacionId])
  @@index([condominioId, unidadId, fecha])
  @@index([condominioId, recaudoId])
  @@map("movimiento_cartera")
}

/// Ajuste sobre una obligación: no la modifica; al aprobarse genera un movimiento.
model AjusteCartera {
  id             String              @id @default(uuid()) @db.Uuid
  condominioId   String              @map("condominio_id") @db.Uuid
  obligacionId   String              @map("obligacion_id") @db.Uuid
  tipo           TipoAjusteCartera
  valor          Decimal             @db.Decimal(18, 2)
  motivo         String              @db.VarChar(1000)
  soporte        String?             @db.VarChar(500)
  estado         EstadoAjusteCartera @default(PENDIENTE)
  solicitadoPor  String              @map("solicitado_por") @db.Uuid
  resueltoPor    String?             @map("resuelto_por") @db.Uuid
  resueltoEn     DateTime?           @map("resuelto_en") @db.Timestamptz(3)
  notaResolucion String?             @map("nota_resolucion") @db.VarChar(1000)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  obligacion Obligacion @relation(fields: [condominioId, obligacionId], references: [condominioId, id])

  @@index([condominioId, estado, createdAt])
  @@index([condominioId, obligacionId])
  @@map("ajuste_cartera")
}

/// Gestión de cobro. No altera saldos.
model GestionCobro {
  id           String       @id @default(uuid()) @db.Uuid
  condominioId String       @map("condominio_id") @db.Uuid
  unidadId     String       @map("unidad_id") @db.Uuid
  fecha        DateTime     @db.Date
  canal        CanalGestion
  contacto     String?      @db.VarChar(180)
  resultado    String       @db.VarChar(1000)
  proximaFecha DateTime?    @map("proxima_fecha") @db.Date
  creadoPor    String       @map("creado_por") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  unidad      UnidadPrivada    @relation(fields: [condominioId, unidadId], references: [condominioId, id])
  compromisos CompromisoPago[]

  @@unique([condominioId, id])
  @@index([condominioId, unidadId, fecha])
  @@index([condominioId, proximaFecha])
  @@map("gestion_cobro")
}

/// Compromiso de pago. No equivale a un pago ni modifica la deuda.
model CompromisoPago {
  id            String           @id @default(uuid()) @db.Uuid
  condominioId  String           @map("condominio_id") @db.Uuid
  unidadId      String           @map("unidad_id") @db.Uuid
  gestionId     String?          @map("gestion_id") @db.Uuid
  fechaPactada  DateTime         @map("fecha_pactada") @db.Date
  valor         Decimal          @db.Decimal(18, 2)
  estado        EstadoCompromiso @default(ABIERTO)
  observaciones String?          @db.VarChar(1000)
  creadoPor     String           @map("creado_por") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  unidad  UnidadPrivada @relation(fields: [condominioId, unidadId], references: [condominioId, id])
  gestion GestionCobro? @relation(fields: [condominioId, gestionId], references: [condominioId, id])

  @@index([condominioId, estado, fechaPactada])
  @@index([condominioId, unidadId])
  @@map("compromiso_pago")
}

/// Borrador de importación de saldos iniciales: nada se crea hasta aprobar.
model ImportacionCartera {
  id           String                   @id @default(uuid()) @db.Uuid
  condominioId String                   @map("condominio_id") @db.Uuid
  archivo      String                   @db.VarChar(180)
  fechaCorte   DateTime                 @map("fecha_corte") @db.Date
  filas        Json
  resumen      Json
  estado       EstadoImportacionCartera @default(PENDIENTE)
  creadaPor    String                   @map("creada_por") @db.Uuid
  aprobadaPor  String?                  @map("aprobada_por") @db.Uuid
  creadaEn     DateTime                 @default(now()) @map("creada_en") @db.Timestamptz(3)
  cerradaEn    DateTime?                @map("cerrada_en") @db.Timestamptz(3)

  @@index([condominioId, estado, creadaEn])
  @@map("importacion_cartera")
}

/// Parámetros generales del sistema (globales, no son datos de un condominio: sin RLS).
/// Solo los cambia el superadministrador, siempre con auditoría.
model ParametroSistema {
  clave          String   @id @db.VarChar(80)
  valor          Json
  actualizadoPor String?  @map("actualizado_por") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("parametro_sistema")
}

/// Periodo autorizado para preparar cuentas; configurar no causa cargos.
model PeriodoCobro {
  id               String             @id @default(uuid()) @db.Uuid
  condominioId     String             @map("condominio_id") @db.Uuid
  periodo          String             @db.VarChar(7)
  fechaCorte       DateTime           @map("fecha_corte") @db.Date
  fechaVencimiento DateTime           @map("fecha_vencimiento") @db.Date
  estado           EstadoPeriodoCobro @default(CONFIGURADO)
  creadoPor        String             @map("creado_por") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  condominio       Condominio         @relation(fields: [condominioId], references: [id])
  conceptos        ConceptoCobro[]
  cuentas          CuentaCobro[]

  @@unique([condominioId, periodo])
  @@unique([condominioId, id])
  @@index([condominioId, estado, periodo])
  @@map("periodo_cobro")
}

/// Conceptos aprobados para incluir en los documentos de cobro.
model ConceptoCobro {
  id           String       @id @default(uuid()) @db.Uuid
  condominioId String       @map("condominio_id") @db.Uuid
  periodoId    String       @map("periodo_id") @db.Uuid
  nombre       String       @db.VarChar(120)
  descripcion  String?      @db.VarChar(300)
  activo       Boolean      @default(true)
  creadoPor    String       @map("creado_por") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  condominio   Condominio   @relation(fields: [condominioId], references: [id])
  periodo      PeriodoCobro @relation(fields: [condominioId, periodoId], references: [condominioId, id], onDelete: Cascade)

  @@index([condominioId, periodoId, activo])
  @@map("concepto_cobro")
}

/// Snapshot inmutable de cartera y titulares al corte; no crea obligaciones contables.
model CuentaCobro {
  id              String             @id @default(uuid()) @db.Uuid
  condominioId    String             @map("condominio_id") @db.Uuid
  periodoId       String             @map("periodo_id") @db.Uuid
  unidadId        String             @map("unidad_id") @db.Uuid
  numero          Int?
  estado          EstadoCuentaCobro  @default(BORRADOR)
  version         Int                @default(1)
  snapshot        Json
  total           Decimal            @db.Decimal(18, 2)
  pdf             Bytes?             @db.ByteA
  generadoPor     String             @map("generado_por") @db.Uuid
  aprobadoPor     String?            @map("aprobado_por") @db.Uuid
  aprobadoEn      DateTime?          @map("aprobado_en") @db.Timestamptz(3)
  emitidoPor      String?            @map("emitido_por") @db.Uuid
  emitidoEn       DateTime?          @map("emitido_en") @db.Timestamptz(3)
  anuladoPor      String?            @map("anulado_por") @db.Uuid
  anuladoEn       DateTime?          @map("anulado_en") @db.Timestamptz(3)
  motivoAnulacion String?            @map("motivo_anulacion") @db.VarChar(1000)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  condominio      Condominio         @relation(fields: [condominioId], references: [id])
  periodo         PeriodoCobro       @relation(fields: [condominioId, periodoId], references: [condominioId, id])
  unidad          UnidadPrivada      @relation(fields: [condominioId, unidadId], references: [condominioId, id])
  envios          EnvioCuentaCobro[]

  @@unique([condominioId, numero])
  @@unique([condominioId, id])
  @@index([condominioId, periodoId, estado])
  @@index([condominioId, unidadId, createdAt])
  @@map("cuenta_cobro")
}

/// Intento/evidencia de distribución del documento emitido.
model EnvioCuentaCobro {
  id           String                 @id @default(uuid()) @db.Uuid
  condominioId String                 @map("condominio_id") @db.Uuid
  cuentaId     String                 @map("cuenta_id") @db.Uuid
  canal        String                 @db.VarChar(30)
  destinatario String                 @db.VarChar(254)
  estado       EstadoEnvioCuentaCobro @default(PENDIENTE)
  detalle      String?                @db.VarChar(500)
  enviadoPor   String                 @map("enviado_por") @db.Uuid
  enviadoEn    DateTime?              @map("enviado_en") @db.Timestamptz(3)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  condominio   Condominio             @relation(fields: [condominioId], references: [id])
  cuenta       CuentaCobro            @relation(fields: [condominioId, cuentaId], references: [condominioId, id])

  @@index([condominioId, cuentaId, createdAt])
  @@map("envio_cuenta_cobro")
}

/// Expediente digital central, aislado por copropiedad y área documental.
model ExpedienteDigital {
  id             String   @id @default(uuid()) @db.Uuid
  condominioId   String   @map("condominio_id") @db.Uuid
  area           String   @db.VarChar(2)
  codigo         String   @db.VarChar(40)
  titulo         String   @db.VarChar(240)
  asunto         String?  @db.VarChar(2000)
  responsable    String?  @db.VarChar(180)
  propietario    String?  @db.VarChar(180)
  villa          String?  @db.VarChar(80)
  propietarioId  String?  @map("propietario_id") @db.Uuid
  unidadId       String?  @map("unidad_id") @db.Uuid
  responsableId  String?  @map("responsable_id") @db.Uuid
  estado         String   @default("ABIERTO") @db.VarChar(30)
  confidencial  Boolean  @default(false)
  fechaVencimiento DateTime? @map("fecha_vencimiento") @db.Date
  vencimientoVerificado Boolean @default(false) @map("vencimiento_verificado")
  creadoPor      String   @map("creado_por") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
