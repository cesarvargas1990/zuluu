  antecedente              String?                @db.VarChar(2000)
  proximoPaso              String?                @map("proximo_paso") @db.VarChar(1000)
  estadoJuridico           EstadoProcesoAmbiental @default(POR_VERIFICAR) @map("estado_juridico")
  estadoTecnico            EstadoProcesoAmbiental @default(POR_VERIFICAR) @map("estado_tecnico")
  prioridad                String                 @default("MEDIA") @db.VarChar(20)
  responsable              String?                @db.VarChar(180)
  fechaExpedicion          DateTime?              @map("fecha_expedicion") @db.Date
  fechaRecepcion           DateTime?              @map("fecha_recepcion") @db.Date
  fechaNotificacion        DateTime?              @map("fecha_notificacion") @db.Date
  notificacionVerificada   Boolean                @default(false) @map("notificacion_verificada")
  plazoDias                Int?                   @map("plazo_dias")
  metodoComputo            String?                @map("metodo_computo") @db.VarChar(300)
  fechaVencimientoValidada DateTime?              @map("fecha_vencimiento_validada") @db.Date
  vencimientoVerificado    Boolean                @default(false) @map("vencimiento_verificado")
  costoEstimado            Decimal?               @map("costo_estimado") @db.Decimal(18, 2)
  creadoPor                String                 @map("creado_por") @db.Uuid
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  condominio             Condominio                      @relation(fields: [condominioId], references: [id])
  actuaciones            ActuacionAmbiental[]
