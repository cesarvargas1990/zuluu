  relacionesProcesos RelacionDocumentoAmbiental[]

  @@unique([condominioId, id])
  @@index([condominioId, procesoId, createdAt])
  @@map("documento_ambiental")
}

/// Vínculos secundarios; el documento conserva su expediente principal y un solo original.
model RelacionDocumentoAmbiental {
