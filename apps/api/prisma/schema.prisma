model DocumentoAmbiental {
  id           String   @id @default(uuid()) @db.Uuid
  condominioId String   @map("condominio_id") @db.Uuid
  procesoId    String   @map("proceso_id") @db.Uuid
  actuacionId  String?  @map("actuacion_id") @db.Uuid
  nombre       String   @db.VarChar(180)
  tipo         String   @db.VarChar(80)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  tamano       Int
  sha256       String   @db.Char(64)
  contenido    Bytes    @db.ByteA
  verificacion String   @default("PENDIENTE_VALIDAR") @db.VarChar(30)
