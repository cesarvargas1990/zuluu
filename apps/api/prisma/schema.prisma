  @@index([condominioId, estadoJuridico, prioridad])
  @@index([condominioId, radicado])
  @@map("proceso_ambiental")
}

/// Actuaciones append-only: el historial fuente no se reemplaza.
model ActuacionAmbiental {
  id                String    @id @default(uuid()) @db.Uuid
  condominioId      String    @map("condominio_id") @db.Uuid
  procesoId         String    @map("proceso_id") @db.Uuid
