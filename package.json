{
  "name": "zulu-admin",
  "private": true,
  "description": "ZULU ADMIN · Majagua Digital — administración de condominios",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @zulu/api prisma:migrate",
    "db:studio": "pnpm --filter @zulu/api prisma:studio"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
